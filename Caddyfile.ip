{
  default_sni {$PUBLIC_IP}
}
(ip_tls) {
  tls {
    issuer acme {
      profile shortlived
    }
  }
}
# 443 keeps the ACME renewal path for the IP certificate; nothing is served here.
https://{$PUBLIC_IP} {
  import ip_tls
  respond 410
}
https://{$PUBLIC_IP}:8443 {
  import ip_tls
  encode zstd gzip
  respond /api/v1/auth/register "Private shared instance" 403
  reverse_proxy sub2api:8080 {
    flush_interval -1
  }
}
